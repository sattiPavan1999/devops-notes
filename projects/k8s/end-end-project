This is the jenkins pipeline:

pipeline {
    agent any
    environment {
        scannerHome = tool 'mysonar'
    }
    stages {
        stage('clean ws') {
            steps {
                cleanWs()
            }
        }
        stage('get codebase') {
            steps {
                git branch: 'main', url: 'https://github.com/sattiPavan1999/3-Tier-Full-Stack-yelp-camp.git'
            }
        }
        stage('CQA') {
            steps {
                withSonarQubeEnv('mysonar') {
                  sh '''${scannerHome}/bin/sonar-scanner -Dsonar.projectName=new-project -Dsonar.projectKey=new-project'''
                }
            }
        }
        stage('quality gates') {
            steps {
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-id'
                }
            }
        }
        stage('build image') {
            steps {
                sh "docker build -t pavanreddy1999/camp-project:v1 ."
            }
        }
        stage('scan image') {
            steps {
                sh "trivy image pavanreddy1999/camp-project:v1"
            }
        }
        stage('image push') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'dockerhub-id') {
                        sh "docker push pavanreddy1999/camp-project:v1"
                    }
                }
            }
        }
        stage('deploy manifests on EKS') {
            steps {
                withKubeCredentials(kubectlCredentials: [[caCertificate: '', clusterName: 'EKS_CLOUD', contextName: '', credentialsId: 'k8s-sevice-account-id', namespace: 'webapps', serverUrl: 'https://672ECED148E7B71CA693F3F78303F9B2.gr7.ap-south-1.eks.amazonaws.com']]) {
                    sh 'kubectl apply -f Manifests/'
                }
            }
        }
    }
    post {
        always {
            mail to: 'sattipavan1999@gmail.com',
            subject: 'pipeline status',
            body: "${currentBuild.currentResult}:* Job ${env.JOB_NAME} \n build ${env.BUILD_NUMBER} \n More info at: ${env.BUILD_URL}"
        }
    }
}
