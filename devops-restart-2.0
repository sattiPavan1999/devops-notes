basic pipeline: Below we need to add artifacts step for test and uat pipeline

pipeline {
    agent {
        node {
            label 'dev'
        }
    }
    environment {
        SCANNER_HOME = "mysonar"
    }
    tools {
        maven 'mymaven'
    }
    stages {
        stage('code') {
            steps {
                git branch: 'develop-1.0', url: 'https://github.com/sattiPavan1999/demorepo.git'
            }
        }
        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }
        stage('CQA') {
            steps {
                sh '''
                mvn org.sonarsource.scanner.maven:sonar-maven-plugin:3.9.1.2184:sonar \
                -Dsonar.projectKey=myproject \
                -Dsonar.host.url=http://18.61.72.103:9000 \
                -Dsonar.login=d8a21554121ad57468b0e0e4a00b56d93db561d7
                '''
            }
        }
        stage("deploy") {
            steps {
                deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: 'tomcat-cred', path: '', url: 'http://98.130.44.175:8080/')], contextPath: 'e-commerce', war: 'target/*.war'
            }
        }
    }
}
